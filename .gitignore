next-env.d.ts

# prepare.js copies plugin routes into src/app/.../plugins/<id>/; keep those generated trees untracked.
# Still track src/plugins/<name>/index.ts etc. via selective un-ignore if needed.
src/plugins/*
src/app/account/plugins/
src/app/admin/plugins/
src/app/(storefront)/plugins/
src/.plugin-routes-manifest.json
src/components/storefront/themes/registry.generated.ts

# Skins are synced into these trees by scripts/prepare.js. Sources live in:
#   - src/skins/<id>/         (built-in skins shipped with bfg-client itself)
#   - src/plugins/<plugin>/skins/<id>/  (extension-contributed via symlink to extensions/)
src/.skin-sync-manifest.json
src/components/storefront/themes/*/
src/components/account/themes/*/
src/components/account/themes/registry.generated.ts
src/components/auth/themes/*/
src/components/auth/themes/registry.generated.ts
public/skins/
public/plugins/

.env*.local
.claude/settings.local.json
