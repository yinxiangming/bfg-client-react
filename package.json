{
  "name": "bfg-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "node scripts/prepare.js",
    "dev": "npm run prepare && node_modules/.bin/next dev",
    "build": "npm run prepare -- --production && node_modules/.bin/next build",
    "start": "node_modules/.bin/next start",
    "typecheck": "node_modules/.bin/tsc --noEmit",
    "lint": "npm run typecheck",
    "check": "npm run typecheck && npm run test:auth-logging && npm run test:guest-cart && npm run test:default-address && npm run test:skin-registry && npm run test:storefront-server && npm run test:plugin-messages && npm run test:plugin-assets && npm run build",
    "test:guest-cart": "node --test scripts/guest-cart.test.mjs",
    "test:auth-logging": "node --test scripts/auth-logging.test.mjs",
    "test:default-address": "node --test scripts/default-address.test.mjs",
    "test:skin-registry": "node --test scripts/skin-registry.test.mjs scripts/skin-availability.test.mjs scripts/generated-sync.test.mjs",
    "test:plugin-assets": "node --test scripts/plugin-public-assets.test.mjs",
    "test:storefront-server": "node --experimental-transform-types --test scripts/storefront-server.test.mjs",
    "test:plugin-messages": "node --experimental-transform-types --test scripts/plugin-messages.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@floating-ui/react": "0.27.16",
    "@iconify/react": "5.1.0",
    "@mui/icons-material": "^7.3.6",
    "@mui/lab": "^7.0.1-beta.19",
    "@mui/material": "7.3.6",
    "@mui/material-nextjs": "7.3.5",
    "@mui/utils": "^7.3.6",
    "@mui/x-data-grid": "^8.22.0",
    "@stripe/react-stripe-js": "^5.4.1",
    "@stripe/stripe-js": "^8.6.1",
    "@tanstack/match-sorter-utils": "^8.19.4",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-image": "3.31.0",
    "@tiptap/extension-placeholder": "3.31.0",
    "@tiptap/extension-text-align": "3.31.0",
    "@tiptap/react": "3.31.0",
    "@tiptap/starter-kit": "3.31.0",
    "apexcharts": "^5.3.6",
    "classnames": "2.5.1",
    "lightningcss": "^1.30.2",
    "next": "^16.3.8",
    "next-intl": "^4.9.2",
    "react": "19.2.0",
    "react-apexcharts": "^1.9.0",
    "react-colorful": "5.6.1",
    "react-datepicker": "^8.10.0",
    "react-dom": "19.2.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.68.0",
    "react-perfect-scrollbar": "1.5.8",
    "react-use": "17.6.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@iconify/json": "2.2.408",
    "@iconify/tools": "4.2.0",
    "@iconify/types": "2.0.0",
    "@iconify/utils": "3.0.2",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.9.4",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.2",
    "@vercel/next": "^4.16.4",
    "baseline-browser-mapping": "^2.11.22",
    "typescript": "5.6.3",
    "@playwright/test": "^1.62.1"
  }
}
